# =============================================================================
# Gantt App — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=gantt
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=gantt

# --- Application ---
# Full connection string (used by the backend container)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Comma-separated allowed origins (restrict in production)
CORS_ORIGINS=*

# Connection pool tuning
DB_POOL_MIN=1
DB_POOL_MAX=10
