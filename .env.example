# =============================================================================
# Gantt App — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Database ---
# Full PostgreSQL connection string.
# For external DB (staging/production):
#   DATABASE_URL=postgresql://user:password@192.168.71.145:5432/superset_analytics_db
#
# If Postgres runs on the Docker host (not in a container), use host.docker.internal:
#   DATABASE_URL=postgresql://user:password@host.docker.internal:5432/dbname
#
# The extra_hosts mapping in docker-compose.yml ensures host.docker.internal
# resolves correctly on Linux hosts.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- CORS ---
# Comma-separated allowed origins. Leave empty to block all cross-origin requests.
# Example: https://persada-stg.mcmc.gov.my,https://analytics-stg.mcmc.gov.my
CORS_ORIGINS=

# --- Connection pool tuning (optional) ---
DB_POOL_MIN=1
DB_POOL_MAX=10
