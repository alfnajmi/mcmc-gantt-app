# =============================================================================
# Gantt App — Environment Variables (Plane-powered)
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Plane.so Integration (required) ---
# Self-hosted Plane instance base URL (no trailing slash)
PLANE_BASE_URL=https://plane.example.com

# Personal Access Token from Plane (Profile Settings → Personal Access Tokens)
PLANE_API_TOKEN=plane_api_YOUR_TOKEN_HERE

# Workspace slug (found in Plane URL: https://plane.example.com/<workspace_slug>/projects/)
PLANE_WORKSPACE_SLUG=my-workspace

# --- CORS ---
# Comma-separated allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# --- Redis (required for recoverable deletion / trash; optional for caching) ---
# Points at whatever Redis-compatible service you're running. With the bundled
# docker-compose.yml this is the "redis" service on the compose network. Swap
# this value to point at a different provider (managed Redis, etc.) — nothing
# else needs to change. If empty, caching is disabled and trash restore fails.
REDIS_URL=redis://redis:6379/0

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# --- Connection pool tuning (optional) ---
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Logging ---
LOG_LEVEL=INFO
