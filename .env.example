# =============================================================================
# Gantt App — Environment Variables (Plane-powered)
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Plane.so Integration (required) ---
# Self-hosted Plane instance base URL (no trailing slash)
PLANE_BASE_URL=https://plane.example.com

# Personal Access Token from Plane (Profile Settings → Personal Access Tokens)
PLANE_API_TOKEN=plane_api_YOUR_TOKEN_HERE

# Workspace slug (found in Plane URL: https://plane.example.com/<workspace_slug>/projects/)
PLANE_WORKSPACE_SLUG=my-workspace

# --- CORS ---
# Comma-separated allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# --- Redis Cache (optional — degrades gracefully if not configured) ---
# Redis connection URL. If empty, caching is disabled and all requests go directly to Plane.
REDIS_URL=

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# --- Connection pool tuning (optional) ---
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Plane.so Integration ---
# Required for the Plane-powered Gantt backend (feat/plane-powered-gantt branch).
PLANE_BASE_URL=https://plane-digd.mcmc.gov.my
PLANE_API_TOKEN=your-plane-api-token
PLANE_WORKSPACE_SLUG=digd

# --- Redis Cache (optional) ---
# If not set, caching is disabled (app still works, just slower).
REDIS_URL=
CACHE_TTL_SECONDS=300
=======
# --- Logging ---
LOG_LEVEL=INFO

