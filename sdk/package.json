{
  "name": "@mcmc/gantt-chart",
  "version": "1.0.0",
  "description": "Embeddable Gantt chart component — Web Component + Vue 3 wrapper",
  "type": "module",
  "main": "dist/gantt-chart.umd.js",
  "module": "dist/gantt-chart.es.js",
  "exports": {
    ".": {
      "import": "./dist/gantt-chart.es.js",
      "require": "./dist/gantt-chart.umd.js"
    },
    "./element": "./dist/gantt-element.js",
    "./vue": "./dist/gantt-vue.es.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dhtmlx-gantt": "^8.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "keywords": ["gantt", "chart", "web-component", "vue", "embed"],
  "license": "MIT"
}
